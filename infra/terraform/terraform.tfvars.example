# 복사해서 terraform.tfvars 로 쓰기 (terraform.tfvars 는 git 에 올리지 않는다)
#   Copy-Item terraform.tfvars.example terraform.tfvars

subscription_id     = "00000000-0000-0000-0000-000000000000" # az account show --query id -o tsv
dns_label           = "cheongdo-course-xx"                   # → cheongdo-course-xx.koreacentral.cloudapp.azure.com
admin_cidr          = "203.0.113.10/32"                      # 내 공인 IP: (Invoke-RestMethod https://api.ipify.org) + "/32"
ssh_public_key_path = "~/.ssh/id_rsa.pub"                    # 없으면 ssh-keygen -t rsa -b 4096

# 선택
# vm_size            = "Standard_B1s"
# repo_ref           = "main"
# auto_shutdown_time = "2300"               # 매일 23:00(한국 시간) 자동 종료
# budget_alert_email = "me@example.com"     # 월 예산 80%(예상) · 100% 알림
# monthly_budget_amount = 30
